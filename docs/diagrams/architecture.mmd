graph TB
    subgraph Frontend["Frontend (React + Vite + Bulma)"]
        UI["Search UI<br/>Multi-query · Sketch · Filters"]
    end

    subgraph Backend["Backend (FastAPI)"]
        direction TB
        Translator["Google Translate<br/>VI → EN"]
        Splitter["Sentence Splitter<br/>Paragraph → N sentences"]

        subgraph Encoders["Dual Encoder (lazy-load, one at a time)"]
            SigLIP2["SigLIP2<br/>google/siglip2-base-patch16-512<br/>768-dim text_vector"]
            TSBIR["TSBIR ViT-B-16<br/>open_clip + TSBIR checkpoint<br/>512-dim clip_vector"]
        end

        Reranker["BGE Reranker v2-m3<br/>Cross-encoder<br/>score(query, objects+OCR)"]
    end

    subgraph Storage["Vector Database"]
        Milvus[("Milvus<br/>HNSW · COSINE<br/>clip_vector (512) + text_vector (768)")]
    end

    UI -->|"POST /api/search"| Translator
    Translator --> Splitter
    Splitter -->|"N sentences"| Encoders
    SigLIP2 -->|"text_vector search"| Milvus
    TSBIR -->|"clip_vector search<br/>(sketch mode)"| Milvus
    Milvus -->|"Top N candidates<br/>RRF fusion"| Reranker
    Reranker -->|"Top K results"| UI

    style SigLIP2 fill:#4a9eff,color:#fff
    style TSBIR fill:#ff9f43,color:#fff
    style Reranker fill:#2ed573,color:#fff
    style Milvus fill:#7c5cfc,color:#fff
